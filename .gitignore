# Secrets — never commit, in any form.
.env
.env.*
!.env.example

# The .unitypackage is a BUILD OUTPUT, not a source file: CI rebuilds it
# reproducibly with tools/pack_unitypackage.py and attaches it to the GitHub
# Release. Run tools/release.sh to produce one locally.
dist~/

# Unity leaves these in any project that consumes this package; they must never
# reach the package repo. (The .verify harness's own bin/obj are ignored by
# .verify/.gitignore.)
Library/
Temp/
Logs/
UserSettings/
MemoryCaptures/
Recordings/
Builds/
*.apk
*.aab
*.unitypackage

# Unity Test Runner / unity CLI output.
test-results.xml
*.TestResults.xml

# Solution files regenerated by the editor. The harness's hand-written
# .verify/*.csproj are tracked on purpose and stay untouched by this rule.
/*.sln
/*.csproj
/*.user

# Tooling and OS junk.
__pycache__/
__pycache__.meta
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# The Examples~ testbeds are real Unity projects; the editor regenerates these
# inside each of them, and the root-only rules above do not reach that deep.
Examples~/*/*.sln
Examples~/*/*.slnx
Examples~/*/*.csproj

# Claude Code agent worktrees (created under the repo by the harness, never source)
.claude/
