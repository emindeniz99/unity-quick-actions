      android:fillColor="#B71C1C"
      android:pathData="M2,48A46,46 0 1,1 94,48A46,46 0 1,1 2,48Z" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M28,34L34,28L68,62L62,68ZM62,28L68,34L34,68L28,62Z" />
</vector>
