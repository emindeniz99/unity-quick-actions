<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-only verification of the Editor + Runtime (editor) code path.
       Uses the UnityEngine/UnityEditor stubs in Stubs/. Not a real build. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>UNITY_EDITOR;UNITY_2022_3_OR_NEWER;UNITY_IOS;UNITY_ANDROID</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs/**/*.cs" />
    <Compile Include="../Runtime/**/*.cs" />
    <Compile Include="../Editor/**/*.cs" />
  </ItemGroup>
</Project>
