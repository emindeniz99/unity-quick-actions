<Project Sdk="Microsoft.NET.Sdk">
  <!-- Executes the platform-agnostic unit tests here via `dotnet test`, against
       the UnityEngine stubs and the no-op (editor) bridge. The Unity Test Runner
       runs the SAME test files plus SerializationTests (which needs real
       JsonUtility and is excluded here). AssemblyName matches the InternalsVisibleTo
       in Runtime/AssemblyInfo.cs so white-box tests can reach internals. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>EminDeniz99.QuickActions.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <DefineConstants>UNITY_EDITOR;UNITY_2021_3_OR_NEWER;QUICKACTIONS_ENABLED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- NUnit stays on the 3.x line ON PURPOSE: Unity Test Runner bundles NUnit 3,
         and NUnit 4 removed the classic Assert.AreEqual API these tests share with
         the in-Editor runner. 3.14.0 is the latest 3.x. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Stubs/**/*.cs" />
    <Compile Include="../Runtime/**/*.cs" />
    <Compile Include="../Tests/Editor/QuickActionsApiTests.cs" />
    <Compile Include="../Tests/Editor/QuickActionItemTests.cs" />
    <!-- The Android static-shortcut resource generator plus the settings type it
         reads. Its own asmdef is defineConstraint'ed to UNITY_ANDROID, so a Unity
         test assembly cannot reference it without breaking on every other build
         target — compiling the source straight into the harness assembly is the
         only way its aapt2-breaking cases get a regression test. -->
    <Compile Include="../Editor/QuickActionsSettings.cs" />
    <Compile Include="../Editor/Android/QuickActionsBuildPostProcessorAndroid.cs" />
    <!-- The built-in icon bytes that post-processor writes (generated by
         tools~/gen_builtin_icons.py), so the harness can hold what it wrote to
         the source of truth byte for byte. -->
    <Compile Include="../Editor/Android/QuickActionsBuiltInIcons.cs" />
    <Compile Include="../Editor/QuickActionsBuiltInIconSet.cs" />
    <Compile Include="../Editor/QuickActionsIconTypeDrawer.cs" />
    <!-- The ungated define-off stripper. Its Strip(path) sweep must remove the
         built-in icons and NOTHING a project owns; that is only testable here. -->
    <Compile Include="../Editor/NativeGate/QuickActionsTrampolineStripperAndroid.cs" />
    <!-- The build-time placeholder/customize pipeline both platform bakers call.
         Compiled here for the same reason as the Android post-processor above:
         its behavior (escaping, precedence, per-locale interpolation) only
         otherwise surfaces inside a real device build's Info.plist / res/xml. -->
    <Compile Include="../Editor/QuickActionsStaticBuild.cs" />
    <Compile Include="EditorTests/**/*.cs" />
  </ItemGroup>
</Project>
