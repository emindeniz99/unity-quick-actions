<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors the Editor.iOS asmdef in isolation: compiles the iOS post-processor
       with ONLY UNITY_IOS defined and WITHOUT the Android post-processor or the
       Android-only NativeGate stripper present, catching accidental cross-platform
       coupling. (The actual extension-DLL resolution is still Unity-only — stubs
       stand in here.) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>UNITY_EDITOR;UNITY_2022_3_OR_NEWER;UNITY_IOS;QUICKACTIONS_ENABLED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs/**/*.cs" />
    <Compile Include="../Runtime/**/*.cs" />
    <Compile Include="../Editor/**/*.cs" Exclude="../Editor/Android/**/*.cs;../Editor/NativeGate/**/*.cs" />
  </ItemGroup>
</Project>
