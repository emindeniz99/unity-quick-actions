<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the app manifest by Unity's Gradle build. Declares the invisible
  trampoline activity that every quick-action intent targets. No <intent-filter>
  here: the app icon's main launcher stays the Unity activity; shortcuts target
  this activity explicitly by class.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.playground.quickactions">
    <application>
        <activity
            android:name="com.playground.quickactions.QuickActionsTrampolineActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />
    </application>
</manifest>
