<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole manifest a resources-only Android Library plug-in needs.

  `package=` and nothing else: an .androidlib is a Gradle library module, and a
  library module has to name itself. Unity 2021.3 and 2022.3 export AGP 7.x,
  where this manifest attribute is still the supported way to do that. AGP 8
  (what Unity 6 exports) removed the attribute in favour of `namespace` in a
  build.gradle — read README.md next to this file before using the sample on a
  Unity 6 project. Change the id to your own reverse-DNS name; it never reaches
  the user, it only has to be unique among the modules in the build.

  No build.gradle here ON PURPOSE. A BARE .androidlib — one without a
  build.gradle of its own — is generated by Unity as a module whose
  AndroidManifest.xml and res/ sit at the ROOT, which is why they sit there and
  not under src/main/. The two layouts are not interchangeable: put res/ under
  src/main/ in a bare .androidlib and the resources are dropped with no warning
  (green build, no icon). Adding a build.gradle flips it the other way. Pick
  one and keep the whole module consistent with it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yourcompany.quickactionicons" />
