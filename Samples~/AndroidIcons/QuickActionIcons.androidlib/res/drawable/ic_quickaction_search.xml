<?xml version="1.0" encoding="utf-8"?>
<!-- Your art, not the package's. IconType.Search is one of the 25 catalog
     entries com.emindeniz99.quick-actions ships no built-in for, so this is
     exactly the drawable README.md's recipe tells you to add: named
     ic_quickaction_<icontype>, so the Java bridge's getIdentifier() lookup
     finds it, and delivered through an .androidlib because
     Assets/Plugins/Android/res/ has been unsupported since Unity 2021.2.

     Same file shape as the four built-ins (Editor/Android/
     QuickActionsBuiltInIcons.cs, generated by tools~/gen_builtin_icons.py):
     48dp on a 96 viewport, a white glyph on a full-bleed coloured disc. The
     disc is not decoration — API 26+ launchers wrap a legacy shortcut drawable
     onto a WHITE plate, where a white-on-transparent glyph is invisible. The
     indigo (#3F51B5) matches the built-ins so a replacement icon sits next to
     them consistently; it is yours to change.

     The magnifier is one white path: an outer circle, an inner circle wound
     the other way (so the non-zero fill rule punches the lens out), then the
     handle as a quad. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
  <path
      android:fillColor="#3F51B5"
      android:pathData="M2,48A46,46 0 1,1 94,48A46,46 0 1,1 2,48Z" />
  <path
      android:fillColor="#FFFFFF"
      android:pathData="M22,42A20,20 0 1,1 62,42A20,20 0 1,1 22,42ZM29,42A13,13 0 1,0 55,42A13,13 0 1,0 29,42ZM54,60L60,54L76,70L70,76Z" />
</vector>
